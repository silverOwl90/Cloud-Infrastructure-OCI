# ---------- Terraform ----------
# Providers and modules downloaded by `terraform init`
.terraform/

# State (holds the kubeconfig and account data in plain text) and its backups
*.tfstate
*.tfstate.*

# Variables with credentials
*.tfvars
*.tfvars.json

# Saved plans, crash logs and local overrides
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# .terraform.lock.hcl IS committed: it pins the provider versions

# ---------- Credentials ----------
# OCI API keys
*.pem

# Kubeconfig generated by Terraform
kubeconfig
